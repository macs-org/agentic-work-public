# Local default. For production use a managed Postgres URL such as:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/autonomous_qa
DATABASE_URL=sqlite:///autonomous_qa.db

# Optional alert delivery. If unset, email alerts are captured in the DB for review.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=qa-agent@example.com

# Production smoke test target.
AUTONOMOUS_QA_BASE_URL=http://127.0.0.1:8000
