# Copy to .env for local use; do not commit real secrets.
APP_API_KEY=dev-api-key
DATABASE_URL=sqlite:///github_activity.db
# Optional authenticated GitHub API polling, increases rate limit to 5,000 req/hr.
GITHUB_TOKEN=
# x402 demo pay-to address override.
PAY_TO=0x9c768177521C9A832B0f8567265ef02E89D0282e
# Uvicorn/runtime defaults for container hosts.
PORT=8000
WEB_CONCURRENCY=1
